<div class="search" data-search>
  <label>
    <span class="sr">Search</span>
    <input type="search" placeholder="Search the docs" autocomplete="off" aria-controls="search-results" />
  </label>
  <p class="sr" role="status"></p>
  <ul id="search-results" aria-label="Search results" hidden></ul>
</div>

<style>
  .search {
    position: relative;
  }
  input {
    width: 15rem;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--tone);
    border-radius: 0;
    padding: 0.45rem 0.6rem;
  }
  ul,
  .note {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: min(28rem, calc(100vw - 2 * var(--margin)));
    max-height: 70vh;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--tone);
  }
  .note {
    left: 0;
    width: auto;
    padding: 0.6rem 0.75rem;
    color: var(--muted);
  }
  ul :global(a) {
    display: block;
    padding: 0.6rem 0.75rem;
    font-weight: 400;
  }
  ul :global(a:hover),
  ul :global(a:focus-visible) {
    background: var(--ground);
    outline-offset: -3px;
  }
  ul :global(b) {
    display: block;
    font-weight: 600;
  }
  ul :global(span) {
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .search {
      display: none;
    }
  }
</style>

<script>
  type Sub = { title: string; url: string; plain_excerpt: string };
  type Data = { meta: { title?: string }; sub_results: Sub[] };
  type Pagefind = { debouncedSearch(query: string): Promise<{ results: { data(): Promise<Data> }[] } | null> };

  const box = document.querySelector<HTMLElement>('[data-search]')!;
  const input = box.querySelector('input')!;
  const status = box.querySelector('[role="status"]')!;
  const list = box.querySelector('ul')!;
  const bundle = '/pagefind/pagefind.js';
  let pagefind: Promise<Pagefind> | undefined;
  let generation = 0;

  const clean = (url: string) => url.replace(/\.html(?=#|$)/, '');
  const links = () => [...list.querySelectorAll('a')];
  const close = () => {
    generation++;
    list.hidden = true;
    status.className = 'sr';
  };

  const show = (found: { data: Data; sub: Sub }[]) => {
    list.replaceChildren(
      ...found.map(({ data, sub }) => {
        const title = data.meta.title ?? '';
        const a = document.createElement('a');
        a.href = clean(sub.url);
        const b = document.createElement('b');
        b.textContent = sub.title === title ? title : `${title} › ${sub.title}`;
        const excerpt = document.createElement('span');
        excerpt.textContent = sub.plain_excerpt;
        a.append(b, excerpt);
        const li = document.createElement('li');
        li.append(a);
        return li;
      }),
    );
    list.hidden = found.length === 0;
    status.className = found.length ? 'sr' : 'note';
    status.textContent = found.length === 1 ? '1 result' : found.length ? `${found.length} results` : 'No results';
  };

  input.addEventListener('input', async () => {
    const query = input.value.trim();
    const current = ++generation;
    list.hidden = true;
    list.replaceChildren();
    status.textContent = '';
    status.className = 'sr';
    if (!query) return;
    try {
      pagefind ??= import(/* @vite-ignore */ bundle);
      const search = await (await pagefind).debouncedSearch(query);
      if (!search) return;
      const pages = await Promise.all(search.results.slice(0, 6).map(r => r.data()));
      if (current !== generation) return;
      show(pages.flatMap(data => data.sub_results.slice(0, 2).map(sub => ({ data, sub }))));
    } catch {
      pagefind = undefined;
      if (current !== generation) return;
      close();
      status.textContent = 'Search is unavailable';
      status.className = 'note';
    }
  });

  box.addEventListener('keydown', event => {
    const all = links();
    const at = all.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === 'Escape') {
      close();
      input.focus();
    } else if (event.key === 'ArrowDown' && !list.hidden && all.length) {
      event.preventDefault();
      all[Math.min(at + 1, all.length - 1)]!.focus();
    } else if (event.key === 'ArrowUp' && at >= 0) {
      event.preventDefault();
      (at === 0 ? input : all[at - 1]!).focus();
    }
  });

  list.addEventListener('mousedown', event => event.preventDefault());

  box.addEventListener('focusout', event => {
    if (!box.contains(event.relatedTarget as Node | null)) close();
  });

  document.addEventListener('pointerdown', event => {
    if (!box.contains(event.target as Node)) close();
  });
</script>
