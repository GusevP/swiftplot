---
import { tagLabels, type Example, type ScriptedExample } from '../examples/define';

interface Props {
  examples: readonly (Example | ScriptedExample)[];
}

const { examples } = Astro.props;
---

<div class="cards">
  {
    examples.map(e => (
      <a href={`/examples/${e.id}`} data-tags={e.tags.join(' ')}>
        <div class="chart" data-id={e.id} data-scripted={e.kind === 'scripted' ? '' : undefined} inert />
        <b>{e.title}</b>
        <span>{e.tags.map(t => tagLabels[t]!.toLowerCase()).join(' · ')}</span>
      </a>
    ))
  }
</div>

<script>
  import { load, loadScripted, mountExample } from '../charts/mount';
  import { whileNear } from '../charts/visible';

  for (const el of document.querySelectorAll<HTMLElement>('.cards .chart'))
    whileNear(
      el,
      async () => {
        const id = el.dataset.id!;
        if (el.dataset.scripted !== undefined) return loadScripted(id);
        const definition = await load(id);
        return (at: HTMLElement) => mountExample(at, definition, {}, { legend: false });
      },
      mount => mount(el),
    );
</script>
