---
import OnThisPage, { type Section } from '../components/OnThisPage.astro';
import Sidebar, { type Group } from '../components/Sidebar.astro';
import Base from './Base.astro';
import '../styles/docs.css';

interface Props {
  title: string;
  description?: string;
  sidebar: readonly Group[];
  sections?: readonly Section[];
}

const { title, description, sidebar, sections } = Astro.props;
---

<Base title={title} description={description}>
  <div class:list={['docs', { wide: !sections }]}>
    <Sidebar groups={sidebar} />
    <main class="doc" data-pagefind-body><slot /></main>
    {sections && <OnThisPage sections={sections} />}
  </div>
</Base>
