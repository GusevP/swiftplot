---
import { pagePath } from '../components/path';
import TopBar from '../components/TopBar.astro';
import { headScript } from '../scripts/preferences';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  onStage?: boolean;
}

const { title, onStage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(pagePath(Astro.url), Astro.site)} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/figtree-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={headScript} />
  </head>
  <body>
    <TopBar onStage={onStage} />
    <slot />
  </body>
</html>
