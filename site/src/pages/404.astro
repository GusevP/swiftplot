---
import Base from '../layouts/Base.astro';
import '../styles/docs.css';
---

<Base title="Page not found · swiftplot">
  <main class="doc">
    <h1>Page not found</h1>
    <p class="intro">
      There is no page at this address. Try the <a href="/examples">examples</a>, the{' '}
      <a href="/guides/getting-started">getting-started guide</a> or the <a href="/reference">reference</a>.
    </p>
  </main>
</Base>

<style>
  main {
    padding: 40px var(--margin) 96px;
  }
</style>
