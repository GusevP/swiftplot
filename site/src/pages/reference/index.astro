---
import Docs from '../../layouts/Docs.astro';
import { sidebar } from '../../reference/index';

const intro =
  'The props, return value and errors of each chart that draws from data, and the options of plot(), each mark, each feature and the scales of the explicit API.';
---

<Docs title="Reference · swiftplot" description={intro} sidebar={sidebar}>
  <h1>Reference</h1>
  <p class="intro">{intro}</p>
  {
    sidebar.map(g => (
      <>
        <h2>{g.label}</h2>
        <ul>
          {g.links.map(l => (
            <li>
              <a href={l.href}>
                <code>{l.label}</code>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Docs>
