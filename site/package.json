{
  "name": "swiftplot-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --exclude-selectors \"[data-for]\"",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.6",
    "@swiftplot/react": "workspace:*",
    "@swiftplot/vue": "workspace:*",
    "astro": "7.4.13",
    "swiftplot": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
