---
import ts from 'typescript';
import { compileScript, parse } from 'vue/compiler-sfc';
import { code } from '../../src/codegen/index';
import { text } from '../../src/codegen/tokens';
import { animatedLive as live } from '../plot-definitions';

const commonjs = (source: string, fileName: string) =>
  ts.transpileModule(source, {
    fileName,
    compilerOptions: {
      module: ts.ModuleKind.CommonJS,
      target: ts.ScriptTarget.ES2022,
      jsx: ts.JsxEmit.ReactJSX,
      esModuleInterop: true,
    },
  }).outputText;
const snippet = (fw: 'js' | 'react' | 'vue') => text(code(fw, live, {}, {}));
const sources = {
  js: commonjs(snippet('js'), 'chart.js'),
  react: commonjs(snippet('react'), 'Chart.tsx'),
  vue: commonjs(
    compileScript(parse(snippet('vue')).descriptor, { id: 'live', inlineTemplate: true }).content,
    'Chart.ts',
  ),
};
---

<html lang="en">
  <head><title>Live snippets</title></head>
  <body data-sources={JSON.stringify(sources)}>
    <div id="chart" style="width: 480px; height: 240px"></div>
    <div id="react" style="width: 480px; height: 240px"></div>
    <div id="vue" style="width: 480px; height: 240px"></div>
    <script>
      import './live';
    </script>
  </body>
</html>
