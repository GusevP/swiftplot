{
  "name": "@swiftplot/vue",
  "version": "0.5.1",
  "description": "Vue components for swiftplot charts",
  "keywords": [
    "chart",
    "charts",
    "plot",
    "canvas",
    "webgl",
    "visualization",
    "dataviz",
    "timeseries",
    "typescript",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GusevP/swiftplot.git",
    "directory": "packages/vue"
  },
  "homepage": "https://swiftplot.dev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:import": "node test/import.mjs"
  },
  "peerDependencies": {
    "swiftplot": "workspace:^",
    "vue": "^3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "^1.65.1",
    "swiftplot": "workspace:*",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
