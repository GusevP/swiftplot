{
  "name": "swiftplot-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GusevP/swiftplot.git"
  },
  "homepage": "https://github.com/GusevP/swiftplot#readme",
  "bugs": {
    "url": "https://github.com/GusevP/swiftplot/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r --workspace-concurrency=1 run test && node --test \"scripts/*.test.mjs\"",
    "test:import": "pnpm -r run test:import",
    "test:smoke": "pnpm -r run test:smoke",
    "release:prepare": "node scripts/prepare.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007"
  }
}
