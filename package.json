{
  "name": "swiftplot-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GusevP/swiftplot.git"
  },
  "homepage": "https://github.com/GusevP/swiftplot#readme",
  "bugs": {
    "url": "https://github.com/GusevP/swiftplot/issues"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter swiftplot run build",
    "typecheck": "pnpm --filter swiftplot run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm --filter swiftplot run test",
    "test:import": "pnpm --filter swiftplot run test:import"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007"
  }
}
