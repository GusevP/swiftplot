{
  "name": "swiftplot",
  "version": "0.0.0",
  "private": true,
  "description": "Small, fast charts on Canvas 2D and WebGL2",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
